- apiVersion: v1
  automountServiceAccountToken: false
  kind: ServiceAccount
  metadata:
    labels:
      app.kubernetes.io/instance: console-cluster-ref
      app.kubernetes.io/managed-by: redpanda-operator
      app.kubernetes.io/name: console
      cluster.redpanda.com/namespace: test-ns
    name: console-cluster-ref-console
    namespace: test-ns
- apiVersion: v1
  kind: Service
  metadata:
    labels:
      app.kubernetes.io/instance: console-cluster-ref
      app.kubernetes.io/managed-by: redpanda-operator
      app.kubernetes.io/name: console
      cluster.redpanda.com/namespace: test-ns
    name: console-cluster-ref-console
    namespace: test-ns
  spec:
    internalTrafficPolicy: Cluster
    ipFamilies:
    - IPv4
    ipFamilyPolicy: SingleStack
    ports:
    - name: http
      port: 8080
      protocol: TCP
      targetPort: 8080
    selector:
      app.kubernetes.io/instance: console-cluster-ref
      app.kubernetes.io/name: console
    sessionAffinity: None
    type: ClusterIP
  status:
    loadBalancer: {}
