    config.yaml: |
      # from .Values.config
      pipelines:
        kubernetes:
          allowBootstrapUser: false
          allowUnauthenticated: false
          clusterRef: test-redpanda
          enabled: true
          impersonateUser: false
          namespace: test-ns
          skipAdmissionCheck: false
          userRef: console-pipelines
  kind: ConfigMap
  metadata:
    labels:
      app.kubernetes.io/instance: console-pipelines-sa
      app.kubernetes.io/managed-by: redpanda-operator
      app.kubernetes.io/name: console
      cluster.redpanda.com/namespace: test-ns
    name: console-pipelines-sa-console
    namespace: test-ns
- apiVersion: apps/v1
  kind: Deployment
  metadata:
    labels:
      app.kubernetes.io/instance: console-pipelines-sa
      app.kubernetes.io/managed-by: redpanda-operator
      app.kubernetes.io/name: console
      cluster.redpanda.com/namespace: test-ns
    name: console-pipelines-sa-console
    namespace: test-ns
  spec:
    progressDeadlineSeconds: 600
    replicas: 1
    revisionHistoryLimit: 10
    selector:
      matchLabels:
        app.kubernetes.io/instance: console-pipelines-sa
        app.kubernetes.io/name: console
    strategy:
      rollingUpdate:
        maxSurge: 25%
        maxUnavailable: 25%
      type: RollingUpdate
    template:
      metadata:
        annotations:
          checksum/config: 3bd9630a76663cf450cd1ded5c0d4b0c1368806267638a188e43642b5fad1c60
        labels:
          app.kubernetes.io/instance: console-pipelines-sa
          app.kubernetes.io/name: console
      spec:
        affinity: {}
        automountServiceAccountToken: true
        containers:
        - args:
          - --config.filepath=/etc/console/configs/config.yaml
          env:
          - name: AUTHENTICATION_JWTSIGNINGKEY
            valueFrom:
              secretKeyRef:
                key: authentication-jwt-signingkey
                name: console-pipelines-sa-console
          - name: REDPANDA_METRICS_K8S_DEPLOYMENT_TYPE
            value: operator
          - name: REDPANDA_METRICS_K8S_CHART_VERSION
          - name: REDPANDA_METRICS_K8S_CONSOLE_IMAGE_VERSION
            value: redpandadata/console:v3.9.0
          - name: REDPANDA_METRICS_K8S_CLUSTER_ID
            value: 00000000-0000-0000-0000-000000000000
          image: docker.redpanda.com/redpandadata/console:v3.9.0
          imagePullPolicy: IfNotPresent
          livenessProbe:
            failureThreshold: 3
            httpGet:
              path: /admin/health
              port: http
              scheme: HTTP
            periodSeconds: 10
            successThreshold: 1
            timeoutSeconds: 1
          name: console
          ports:
          - containerPort: 8080
            name: http
            protocol: TCP
          readinessProbe:
            failureThreshold: 3
            httpGet:
              path: /admin/health
              port: http
              scheme: HTTP
            initialDelaySeconds: 10
            periodSeconds: 10
            successThreshold: 1
            timeoutSeconds: 1
          resources: {}
          securityContext:
            runAsNonRoot: true
          terminationMessagePath: /dev/termination-log
          terminationMessagePolicy: File
          volumeMounts:
          - mountPath: /etc/console/configs
            name: configs
            readOnly: true
          - mountPath: /etc/console/secrets
            name: secrets
            readOnly: true
        dnsPolicy: ClusterFirst
        restartPolicy: Always
        schedulerName: default-scheduler
        securityContext:
          fsGroup: 99
          fsGroupChangePolicy: Always
          runAsUser: 99
        serviceAccount: console-pipelines-sa-console
        serviceAccountName: console-pipelines-sa-console
        terminationGracePeriodSeconds: 30
        volumes:
        - configMap:
            defaultMode: 420
            name: console-pipelines-sa-console
          name: configs
        - name: secrets
          secret:
            defaultMode: 420
            secretName: console-pipelines-sa-console
  status: {}
