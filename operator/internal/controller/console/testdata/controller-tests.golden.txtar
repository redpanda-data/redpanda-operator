- apiVersion: admissionregistration.k8s.io/v1
  kind: ValidatingAdmissionPolicy
  metadata:
    labels:
      app.kubernetes.io/instance: console-pipelines-sa
      app.kubernetes.io/managed-by: redpanda-operator
      app.kubernetes.io/name: console
      cluster.redpanda.com/namespace: test-ns
    name: console-pipelines-sa-console-dc3f659f-pipelines
  spec:
    failurePolicy: Fail
    matchConditions:
    - expression: request.userInfo.username == "system:serviceaccount:test-ns:console-pipelines-sa-console"
      name: console-service-account
    matchConstraints:
      matchPolicy: Equivalent
      namespaceSelector: {}
      objectSelector: {}
      resourceRules:
      - apiGroups:
        - cluster.redpanda.com
        apiVersions:
        - '*'
        operations:
        - CREATE
        - UPDATE
        - DELETE
        resources:
        - pipelines
        scope: '*'
    validations:
    - expression: request.operation == 'DELETE' || (has(object.metadata.labels) &&
        'console.redpanda.com/managed-by' in object.metadata.labels && object.metadata.labels['console.redpanda.com/managed-by']
        == 'console')
      message: Redpanda Console may only write Pipelines labeled console.redpanda.com/managed-by=console
    - expression: request.operation == 'CREATE' || (has(oldObject.metadata.labels)
        && 'console.redpanda.com/managed-by' in oldObject.metadata.labels && oldObject.metadata.labels['console.redpanda.com/managed-by']
        == 'console')
      message: Redpanda Console may only update or delete Pipelines labeled console.redpanda.com/managed-by=console
    - expression: request.operation == 'DELETE' || !has(object.metadata.ownerReferences)
        || size(object.metadata.ownerReferences) == 0
      message: Redpanda Console may not set metadata.ownerReferences on Pipelines
    - expression: request.operation == 'DELETE' || variables.finalizers == variables.oldFinalizers
      message: Redpanda Console may not add or remove metadata.finalizers on Pipelines
    - expression: size(variables.forbiddenSpecFields) == 0
      messageExpression: '''Redpanda Console may only set spec fields '' + variables.allowedSpecFields.join('',
        '') + ''; found '' + variables.forbiddenSpecFields.join('', '')'
    - expression: '!(''resources'' in variables.specFields) || variables.spec.resources.all(k,
        (k == ''requests'' || k == ''limits'') && dyn(variables.spec.resources[k]).all(r,
        r == ''cpu'' || r == ''memory''))'
      message: Redpanda Console may only set cpu and memory in spec.resources.requests
        and spec.resources.limits
    - expression: '!(''cluster'' in variables.specFields) || (variables.clusterRef
        != '''' && variables.spec.cluster.all(f, f == ''clusterRef'') && has(variables.spec.cluster.clusterRef)
        && dyn(variables.spec.cluster.clusterRef).all(f, f == ''name'') && variables.spec.cluster.clusterRef.name
        == variables.clusterRef)'
      messageExpression: 'variables.clusterRef == '''' ? ''Redpanda Console may not
        set spec.cluster'' : ''Redpanda Console may only set spec.cluster.clusterRef.name,
        to '' + variables.clusterRef'
    - expression: '!(''userRef'' in variables.specFields) || (variables.userRef !=
        '''' && dyn(variables.spec.userRef).all(f, f == ''name'') && has(variables.spec.userRef.name)
        && variables.spec.userRef.name == variables.userRef)'
      messageExpression: 'variables.userRef == '''' ? ''Redpanda Console may not set
        spec.userRef'' : ''Redpanda Console may only set spec.userRef.name, to ''
        + variables.userRef'
    - expression: variables.allowBootstrapUser || !('cluster' in variables.specFields)
        || 'userRef' in variables.specFields
      messageExpression: '''Redpanda Console must set spec.userRef.name to '' + variables.userRef
        + '' on Pipelines that set spec.cluster'''
    variables:
    - expression: 'request.operation == ''DELETE'' || !has(object.spec) ? {} : dyn(object.spec)'
      name: spec
    - expression: 'request.operation == ''DELETE'' || !has(object.metadata.finalizers)
        ? [] : dyn(object.metadata.finalizers)'
      name: finalizers
    - expression: 'request.operation != ''UPDATE'' || !has(oldObject.metadata.finalizers)
        ? [] : dyn(oldObject.metadata.finalizers)'
      name: oldFinalizers
    - expression: '[''configYaml'', ''displayName'', ''description'', ''tags'', ''resources'',
        ''paused'', ''replicas'', ''updateStrategy'', ''cluster'', ''userRef'']'
      name: allowedSpecFields
    - expression: variables.spec.filter(f, true)
      name: specFields
    - expression: variables.specFields.filter(f, !(f in variables.allowedSpecFields))
      name: forbiddenSpecFields
    - expression: '"test-redpanda"'
      name: clusterRef
    - expression: '"console-pipelines"'
      name: userRef
    - expression: "false"
      name: allowBootstrapUser
  status: {}
