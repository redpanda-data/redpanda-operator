                  timeout -v 45 bash -x /var/lifecycle/postStart.sh 2>&1 | sed "s/^/lifecycle-hook post-start $(date): /" | tee /proc/1/fd/1
                  ec=${PIPESTATUS[0]}
                  if [ "$ec" = "124" ] || [ "$ec" = "137" ]; then
